{
    "name": "dereuromark/cakephp-workflow",
    "description": "State machine and workflow engine for CakePHP 5.x with PHP 8 Attributes, YAML support, and admin UI",
    "type": "cakephp-plugin",
    "license": "MIT",
    "require": {
        "php": ">=8.2",
        "cakephp/cakephp": "^5.2",
        "symfony/yaml": "^6.0 || ^7.0"
    },
    "require-dev": {
        "phpunit/phpunit": "^10.1 || ^11.0",
        "cakephp/cakephp-codesniffer": "^5.0"
    },
    "autoload": {
        "psr-4": {
            "Workflow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Workflow\\Test\\": "tests/"
        }
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
