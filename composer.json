{
    "name": "dereuromark/cakephp-workflow",
    "description": "State machine and workflow engine for CakePHP with PHP 8 Attributes, YAML support, and admin UI",
    "type": "cakephp-plugin",
    "keywords": [
        "cakephp",
        "plugin",
        "workflow",
        "state-machine",
        "fsm",
        "attributes",
        "yaml",
        "admin-panel",
        "standalone-ui"
    ],
    "homepage": "https://github.com/dereuromark/cakephp-workflow",
    "license": "MIT",
    "authors": [
        {
            "name": "Mark Scherer",
            "role": "Author",
            "homepage": "https://www.dereuromark.de"
        }
    ],
    "require": {
        "php": ">=8.2",
        "cakephp/cakephp": "^5.2",
        "symfony/yaml": "^6.0 || ^7.0"
    },
    "require-dev": {
        "cakephp/migrations": "^4.0.0",
        "php-collective/code-sniffer": "^0.5.4",
        "phpunit/phpunit": "^11.5 || ^12.5 || ^13.0"
    },
    "autoload": {
        "psr-4": {
            "Workflow\\": "src/"
        }
    },
    "autoload-dev": {
        "psr-4": {
            "Workflow\\Test\\": "tests/",
            "Cake\\Test\\": "vendor/cakephp/cakephp/tests/",
            "TestApp\\": "tests/test_app/src/"
        }
    },
    "scripts": {
        "check": [
            "@cs-check",
            "@test"
        ],
        "cs-check": "phpcs --colors --parallel=16",
        "cs-fix": "phpcbf --colors --parallel=16",
        "stan": "phpstan analyze",
        "stan-setup": "cp composer.json composer.backup && composer require --dev phpstan/phpstan:^2.0.0 && mv composer.backup composer.json",
        "test": "phpunit",
        "coverage-test": "phpunit --stderr --coverage-clover=clover.xml"
    },
    "config": {
        "sort-packages": true,
        "allow-plugins": {
            "dealerdirect/phpcodesniffer-composer-installer": true
        }
    }
}
