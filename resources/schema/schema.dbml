// cakephp-workflow — database schema snapshot (DBML)
//
// A merged snapshot of all plugin migrations under config/Migrations/.
// Hand-maintained: update it when you add a migration that changes these tables.
// Paste into https://dbdiagram.io (or any DBML tool) to view/diagram.
// DBML reference: https://dbml.dbdiagram.io/docs
//
// Note: foreign_key is a *polymorphic* reference to your application's records — each
// row may point at a different table — so it is intentionally not a real foreign key.
// It defaults to a (big)integer; widen it to varchar(36) for UUID / char primary keys.

Project cakephp_workflow {
  database_type: 'Generic'
  Note: 'Workflow plugin tables only. Your own entity tables are referenced loosely via foreign_key.'
}

Table workflow_transitions {
  id integer [pk, increment]
  workflow_name varchar(64) [not null]
  model varchar(128) [not null]
  foreign_key int [not null, note: 'Polymorphic entity id; set Polymorphic.type to biginteger/uuid/binaryuuid to change']
  transition_name varchar(64) [not null]
  from_state varchar(64) [not null]
  to_state varchar(64) [not null]
  status varchar(16) [not null, default: 'success']
  user_id varchar(36) [null]
  reason text [null]
  context text [null]
  idempotency_key varchar(128) [null]
  workflow_version varchar(16) [null]
  created datetime [not null]

  indexes {
    (workflow_name, model, foreign_key)
    (workflow_name, from_state)
    created
    status
    idempotency_key
  }
}

Table workflow_locks {
  id integer [pk, increment]
  workflow_name varchar(64) [not null]
  model varchar(128) [not null]
  foreign_key int [not null, note: 'Polymorphic entity id; set Polymorphic.type to biginteger/uuid/binaryuuid to change']
  locked_by varchar(128) [null]
  expires_at datetime [not null]
  created datetime [not null]

  indexes {
    (workflow_name, model, foreign_key) [unique, name: 'workflow_locks_unique']
  }
}

Table workflow_timeouts {
  id integer [pk, increment]
  workflow_name varchar(64) [not null]
  model varchar(128) [not null]
  foreign_key int [not null, note: 'Polymorphic entity id; set Polymorphic.type to biginteger/uuid/binaryuuid to change']
  current_state varchar(64) [not null]
  transition_name varchar(64) [not null]
  due_at datetime [not null]
  processed boolean [not null, default: false]
  created datetime [not null]

  indexes {
    (due_at, processed)
    (workflow_name, model, foreign_key)
  }
}
